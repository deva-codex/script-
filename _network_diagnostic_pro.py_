# LOGGING INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────
class DualLogger:
    """Intercepts output, strips ANSI, buffers for reporting, and logs to file."""
    def __init__(self):
        self.terminal = sys.stdout
        self.log_buffer = []
        self.ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
        
        # File logging
        log_dir = Path.home() / ".wifi_diagnostic" / "logs"
        log_dir.mkdir(parents=True, exist_ok=True)
        self.log_file = log_dir / f"scan_{datetime.now():%Y%m%d_%H%M%S}.log"
        
    def write(self, message):
        self.terminal.write(message)
        clean_msg = self.ansi_escape.sub('', message)
        self.log_buffer.append(clean_msg)
        
        # Write to file (non-blocking)
        threading.Thread(target=self._write_to_file, args=(clean_msg,), daemon=True).start()
    
    def _write_to_file(self, message):
        try:
            with open(self.log_file, 'a', encoding='utf-8') as f:
                f.write(message)
        except Exception:
            pass
    
    def flush(self):
        self.terminal.flush()

sys_logger = DualLogger()
sys.stdout = sys_logger

# ─────────────────────────────────────────────────────────────────────────────
# TERMINAL UI / COLORS
# ─────────────────────────────────────────────────────────────────────────────
class TerminalUI:
    """Advanced terminal output with color codes & formatting."""
    RESET = "\033[0m"
    BOLD = "\033[1m"
    UNDERLINE = "\033[4m"
    BLINK = "\033[5m"
    
    # Colors
    BLACK = "\033[30m"
    RED = "\033[91m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    MAGENTA = "\033[95m"
    CYAN = "\033[96m"
    WHITE = "\033[97m"
    DIM = "\033[2m"
    
    # Background
    BG_RED = "\033[41m"
    BG_GREEN = "\033[42m"
    BG_YELLOW = "\033[43m"
    BG_BLUE = "\033[44m"

    @classmethod
    def banner(cls, title: str) -> None:
        """Hacker-style banner."""
        print(f"\n{cls.BOLD}{cls.CYAN}{'��' * 80}{cls.RESET}")
        print(f"{cls.BOLD}{cls.CYAN}► {title}{cls.RESET}")
        print(f"{cls.BOLD}{cls.CYAN}{'─' * 80}{cls.RESET}")

    @classmethod
    def h1(cls, text: str) -> None:
        print(f"\n{cls.BOLD}{cls.CYAN}{'═' * 80}{cls.RESET}")
        print(f"{cls.BOLD}{cls.CYAN}  {text}{cls.RESET}")
        print(f"{cls.BOLD}{cls.CYAN}{'═' * 80}{cls.RESET}")

    @classmethod
    def h2(cls, text: str) -> None:
        print(f"\n{cls.BOLD}{cls.YELLOW}  ▸ {text}{cls.RESET}")

    @classmethod
    def h3(cls, text: str) -> None:
        print(f"{cls.BOLD}{cls.MAGENTA}    ◆ {text}{cls.RESET}")

    @classmethod
    def kv(cls, k: str, v: str, status: Optional[str] = None) -> None:
        status_str = ""
        if status == "ok":
            status_str = f" {cls.GREEN}[✓]{cls.RESET}"
        elif status == "warn":
            status_str = f" {cls.YELLOW}[!]{cls.RESET}"
        elif status == "critical":
            status_str = f" {cls.RED}[✗]{cls.RESET}"
        
        print(f"    {cls.GREEN}{k:<35}{cls.RESET}{v}{status_str}")

    @classmethod
    def warn(cls, text: str) -> None:
        print(f"    {cls.RED}⚠  {text}{cls.RESET}")

    @classmethod
    def success(cls, text: str) -> None:
        print(f"    {cls.GREEN}✔  {text}{cls.RESET}")

    @classmethod
    def info(cls, text: str) -> None:
        print(f"    {cls.BLUE}ℹ  {text}{cls.RESET}")

    @classmethod
    def dim(cls, text: str) -> None:
        print(f"    {cls.DIM}{text}{cls.RESET}")

    @classmethod
    def table_row(cls, *columns, widths: List[int] = None) -> None:
        """Print a formatted table row."""
        if widths is None:
            widths = [20] * len(columns)
        
        row = ""
        for col, width in zip(columns, widths):
            row += f"{str(col):<{width}} "
        print(f"    {cls.DIM}{row}{cls.RESET}")


# ─────────────────────────────────────────────────────────────────────────────
# DATA MODELS & ENUMS
# ─────────────────────────────────────────────────────────────────────────────
class SecurityLevel(Enum):
    CRITICAL = "CRITICAL"
    HIGH = "HIGH"
    MEDIUM = "MEDIUM"
    LOW = "LOW"
    INFO = "INFO"

@dataclass
class NetworkInterface:
    name: str
    status: str
    ipv4: Optional[str] = None
    ipv6: Optional[str] = None
    mac: Optional[str] = None
    speed: Optional[int] = None
    mtu: Optional[int] = None
    packets_sent: int = 0
    packets_recv: int = 0
    bytes_sent: int = 0
    bytes_recv: int = 0
    errors: int = 0
    dropped: int = 0

@dataclass
class Connection:
    protocol: str
    local_addr: str
    local_port: int
    remote_addr: str
    remote_port: int
    status: str
    pid: Optional[int] = None
    process_name: Optional[str] = None

@dataclass
class SecurityAlert:
    level: SecurityLevel
    category: str
    message: str
    timestamp: datetime
    remediation: str

@dataclass
class ScanResult:
    scan_id: str
    timestamp: datetime
    hostname: str
    os_type: str
    interfaces: List[NetworkInterface]
    connections: List[Connection]
    dns_servers: List[str]
    gateways: List[str]
    alerts: List[SecurityAlert]
    security_score: float


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE LAYER - PERSISTENT STORAGE & ANALYTICS
# ─────────────────────────────────────────────────────────────────────────────
class DiagnosticDatabase:
    """SQLite-based persistent storage for diagnostic data with analytics."""
    
    def __init__(self):
        self.db_path = Path.home() / ".wifi_diagnostic" / "diagnostic.db"
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self._init_db()
    
    def _init_db(self):
        """Initialize database schema on first run."""
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.cursor()
            
            # Scan history
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS scans (
                    scan_id TEXT PRIMARY KEY,
                    timestamp DATETIME,
                    hostname TEXT,
                    os_type TEXT,
                    security_score REAL,
                    alert_count INTEGER,
                    json_data TEXT
                )
            """)
            
            # Interface history for trend analysis
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS interface_history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    scan_id TEXT,
                    interface_name TEXT,
                    status TEXT,
                    bytes_sent INTEGER,
                    bytes_recv INTEGER,
                    errors INTEGER,
                    dropped INTEGER,
                    timestamp DATETIME,
                    FOREIGN KEY (scan_id) REFERENCES scans(scan_id)
                )
            """)
            
            # Security alerts archive
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS security_alerts (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    scan_id TEXT,
                    level TEXT,
                    category TEXT,
                    message TEXT,
                    timestamp DATETIME,
                    remediation TEXT,
                    FOREIGN KEY (scan_id) REFERENCES scans(scan_id)
                )
            """)
            
            # Connection tracking
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS connections (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    scan_id TEXT,
                    protocol TEXT,
                    remote_addr TEXT,
                    remote_port INTEGER,
                    process_name TEXT,
                    first_seen DATETIME,
                    last_seen DATETIME,
                    count INTEGER,
                    FOREIGN KEY (scan_id) REFERENCES scans(scan_id)
                )
            """)
            
            # Create indices for fast queries
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_scan_timestamp ON scans(timestamp)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_interface_scan ON interface_history(scan_id)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_alert_level ON security_alerts(level)")
            
            conn.commit()
    
    def save_scan(self, result: ScanResult) -> None:
        """Save scan results to database."""
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.cursor()
            
            # Save scan metadata
            cursor.execute("""
                INSERT INTO scans (scan_id, timestamp, hostname, os_type, security_score, alert_count, json_data)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, (
                result.scan_id,
                result.timestamp,
                result.hostname,
                result.os_type,
                result.security_score,
                len(result.alerts),
                json.dumps({
                    'interfaces': [asdict(i) for i in result.interfaces],
                    'connections': [asdict(c) for c in result.connections],
                    'alerts': [{'level': a.level.value, 'category': a.category, 'message': a.message, 'remediation': a.remediation} for a in result.alerts]
                }, default=str)
            ))
            
            # Save interface history
            for iface in result.interfaces:
                cursor.execute("""
                    INSERT INTO interface_history 
                    (scan_id, interface_name, status, bytes_sent, bytes_recv, errors, dropped, timestamp)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    result.scan_id, iface.name, iface.status, iface.bytes_sent, 
                    iface.bytes_recv, iface.errors, iface.dropped, result.timestamp
                ))
            
            # Save alerts
            for alert in result.alerts:
                cursor.execute("""
                    INSERT INTO security_alerts (scan_id, level, category, message, timestamp, remediation)
                    VALUES (?, ?, ?, ?, ?, ?)
                """, (
                    result.scan_id, alert.level.value, alert.category, 
                    alert.message, alert.timestamp, alert.remediation
                ))
            
            conn.commit()
    
    def get_scan_history(self, days: int = 7) -> List[Dict[str, Any]]:
        """Get scan history from past N days."""
        with sqlite3.connect(self.db_path) as conn:
            conn.row_factory = sqlite3.Row
            cursor = conn.cursor()
            cursor.execute("""
                SELECT * FROM scans 
                WHERE timestamp >= datetime('now', '-' || ? || ' days')
                ORDER BY timestamp DESC
            """, (days,))
            return [dict(row) for row in cursor.fetchall()]
    
    def get_trend_analysis(self, days: int = 30) -> Dict[str, Any]:
        """Analyze trends over time."""
        with sqlite3.connect(self.db_path) as conn:
            conn.row_factory = sqlite3.Row
            cursor = conn.cursor()
            
            # Average security score trend
            cursor.execute("""
                SELECT AVG(security_score) as avg_score, COUNT(*) as scan_count
                FROM scans
                WHERE timestamp >= datetime('now', '-' || ? || ' days')
            """, (days,))
            trend = dict(cursor.fetchone())
            
            # Most common alerts
            cursor.execute("""
                SELECT level, category, COUNT(*) as count
                FROM security_alerts
                WHERE timestamp >= datetime('now', '-' || ? || ' days')
                GROUP BY level, category
                ORDER BY count DESC
                LIMIT 10
            """, (days,))
            trend['top_alerts'] = [dict(row) for row in cursor.fetchall()]
            
            return trend


# ─────────────────────────────────────────────────────────────────────────────
# COMMAND EXECUTOR - SECURE SUBPROCESS HANDLING
# ─────────────────────────────────────────────────────────────────────────────
class CommandExecutor:
    """Secure command execution with timeout & error handling."""
    
    @staticmethod
    def run(args: List[str], timeout: int = 10) -> str:
        """Execute command safely without shell injection vectors."""
        try:
            result = subprocess.run(
                args,
                shell=False,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False
            )
            return result.stdout.strip()
        except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
            return ""
    
    @staticmethod
    def run_and_print(args: List[str], label: str, filter_keyword: Optional[str] = None) -> None:
        """Execute and display output with optional filtering."""
        out = CommandExecutor.run(args)
        if not out:
            return
        
        TerminalUI.h2(label)
        line_count = 0
        for line in out.splitlines():
            clean_line = line.strip()
            if filter_keyword:
                if filter_keyword.lower() in clean_line.lower():
                    TerminalUI.dim(clean_line)
                    line_count += 1
            else:
                TerminalUI.dim(clean_line)
                line_count += 1
            
            # Limit output to prevent spam
            if line_count >= 50:
                TerminalUI.dim(f"... ({len(out.splitlines()) - line_count} more lines)")
                break


# ─────────────────────────────────────────────────────────────────────────────
# THREAT DETECTION & SECURITY ANALYSIS
# ─────────────────────────────────────────────────────────────────────────────
class SecurityAnalyzer:
    """Threat detection and security scoring engine."""
    
    # Known suspicious ports
    SUSPICIOUS_PORTS = {
        31337: "Back Orifice",
        666: "Possible Malware",
        27374: "SubSeven",
        12345: "NetBus",
        54320: "Possible Bot",
    }
    
    # Known dangerous remote IPs (simplified - in production use threat feeds)
    DANGEROUS_RANGES = [
        "192.168.",  # Private
        "10.",       # Private
        "172.16.",   # Private
    ]
    
    alerts: List[SecurityAlert] = []
    
    @classmethod
    def analyze_connections(cls, connections: List[Connection]) -> List[SecurityAlert]:
        """Analyze active connections for threats."""
        cls.alerts = []
        
        # Check for suspicious listening ports
        listening = [c for c in connections if c.status == "LISTEN"]
        for conn in listening:
            if conn.local_port in cls.SUSPICIOUS_PORTS:
                cls.alerts.append(SecurityAlert(
                    level=SecurityLevel.CRITICAL,
                    category="Suspicious Port",
                    message=f"Process listening on suspicious port {conn.local_port} ({cls.SUSPICIOUS_PORTS[conn.local_port]})",
                    timestamp=datetime.now(),
                    remediation=f"Kill process {conn.pid} if unauthorized: sudo kill {conn.pid}"
                ))
        
        # Check for excessive connections
        established = [c for c in connections if c.status == "ESTABLISHED"]
        if len(established) > 100:
            cls.alerts.append(SecurityAlert(
                level=SecurityLevel.HIGH,
                category="Connection Anomaly",
                message=f"Unusual high number of established connections: {len(established)}",
                timestamp=datetime.now(),
                remediation="Monitor process activity with 'netstat -an' or 'ss -an'"
            ))
        
        # Check for suspicious remote connections
        for conn in established[:50]:  # Check first 50
            if conn.remote_port in [445, 139, 135]:  # Windows share protocols
                if not any(conn.remote_addr.startswith(r) for r in ["192.168.", "10.", "172.16."]):
                    cls.alerts.append(SecurityAlert(
                        level=SecurityLevel.HIGH,
                        category="Suspicious Protocol",
                        message=f"Possible Windows share access from external host: {conn.remote_addr}",
                        timestamp=datetime.now(),
                        remediation="Block incoming SMB traffic on port 445/139"
                    ))
        
        return cls.alerts
    
    @classmethod
    def analyze_interfaces(cls, interfaces: List[NetworkInterface]) -> List[SecurityAlert]:
        """Analyze network interfaces for issues."""
        for iface in interfaces:
            # Check for high error rates
            if iface.errors > 100:
                cls.alerts.append(SecurityAlert(
                    level=SecurityLevel.MEDIUM,
                    category="Interface Errors",
                    message=f"Interface {iface.name} has {iface.errors} transmission errors",
                    timestamp=datetime.now(),
                    remediation="Check cable connections, firmware updates, or hardware issues"
                ))
            
            # Check for dropped packets
            if iface.dropped > 50:
                cls.alerts.append(SecurityAlert(
                    level=SecurityLevel.MEDIUM,
                    category="Dropped Packets",
                    message=f"Interface {iface.name} dropped {iface.dropped} packets",
                    timestamp=datetime.now(),
                    remediation="May indicate network congestion or driver issues"
                ))
        
        return cls.alerts
    
    @classmethod
    def calculate_security_score(cls, alerts: List[SecurityAlert]) -> float:
        """Calculate security score based on alerts (0-100)."""
        score = 100.0
        
        for alert in alerts:
            if alert.level == SecurityLevel.CRITICAL:
                score -= 20
            elif alert.level == SecurityLevel.HIGH:
                score -= 10
            elif alert.level == SecurityLevel.MEDIUM:
                score -= 5
            elif alert.level == SecurityLevel.LOW:
                score -= 2
        
        return max(0.0, score)


# ─────────────────────────────────────────────────────────────────────────────
# CORE DIAGNOSTIC ENGINE
# ────────────────────────────────────────────────────���────────────────────────
class NetworkDiagnostics:
    """Advanced network diagnostics with security analysis."""
    
    OS_TYPE = platform.system()
    
    @staticmethod
    def system_info() -> Dict[str, str]:
        """Gather system information."""
        TerminalUI.h1("SYSTEM OVERVIEW")
        
        info = {
            'hostname': socket.gethostname(),
            'fqdn': socket.getfqdn(),
            'os': f"{platform.system()} {platform.release()}",
            'machine': platform.machine(),
            'processor': platform.processor() or "n/a",
            'python': platform.python_version(),
            'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }
        
        TerminalUI.kv("Hostname", info['hostname'])
        TerminalUI.kv("FQDN", info['fqdn'])
        TerminalUI.kv("OS", info['os'])
        TerminalUI.kv("Machine", info['machine'])
        TerminalUI.kv("Processor", info['processor'])
        TerminalUI.kv("Python Version", info['python'])
        TerminalUI.kv("Scan Time", info['timestamp'])
        
        return info
    
    @staticmethod
    def network_interfaces() -> List[NetworkInterface]:
        """Analyze all network interfaces with detailed stats."""
        TerminalUI.h1("NETWORK INTERFACES ANALYSIS")
        
        interfaces = []
        
        if not HAS_PSUTIL:
            TerminalUI.warn("psutil not installed — run: pip install psutil")
            return interfaces
        
        try:
            addrs = psutil.net_if_addrs()
            stats = psutil.net_if_stats()
            io_ctrs = psutil.net_io_counters(pernic=True)
            
            for iface_name, addr_list in sorted(addrs.items()):
                iface_info = NetworkInterface(
                    name=iface_name,
                    status="UP" if stats[iface_name].isup else "DOWN",
                    speed=stats[iface_name].speed,
                    mtu=stats[iface_name].mtu
                )
                
                # Parse addresses
                for addr in addr_list:
                    if addr.family == socket.AF_INET:
                        iface_info.ipv4 = addr.address
                    elif addr.family == socket.AF_INET6:
                        iface_info.ipv6 = addr.address
                    elif str(addr.family) == "AddressFamily.AF_LINK":
                        iface_info.mac = addr.address
                
                # Get I/O stats
                if iface_name in io_ctrs:
                    c = io_ctrs[iface_name]
                    iface_info.bytes_sent = c.bytes_sent
                    iface_info.bytes_recv = c.bytes_recv
                    iface_info.errors = c.errin + c.errout
                    iface_info.dropped = c.dropin + c.dropout
                
                interfaces.append(iface_info)
                
                # Display
                status_symbol = "✓" if iface_info.status == "UP" else "✗"
                TerminalUI.h2(f"Interface: {iface_info.name} {status_symbol}")
                TerminalUI.kv("Status", f"{iface_info.status} (Speed: {iface_info.speed} Mbps, MTU: {iface_info.mtu})")
                if iface_info.ipv4:
                    TerminalUI.kv("IPv4", iface_info.ipv4)
                if iface_info.ipv6:
                    TerminalUI.kv("IPv6", iface_info.ipv6)
                if iface_info.mac:
                    TerminalUI.kv("MAC Address", iface_info.mac)
                
                if iface_info.bytes_sent or iface_info.bytes_recv:
                    sent_mb = iface_info.bytes_sent / (1024 * 1024)
                    recv_mb = iface_info.bytes_recv / (1024 * 1024)
                    TerminalUI.kv("Data Transfer", f"↑ {sent_mb:.1f} MB  ↓ {recv_mb:.1f} MB")
                
                if iface_info.errors > 0:
                    TerminalUI.kv("Errors", str(iface_info.errors), status="warn")
                if iface_info.dropped > 0:
                    TerminalUI.kv("Dropped", str(iface_info.dropped), status="warn")
        
        except Exception as e:
            TerminalUI.warn(f"Error gathering interface info: {e}")
        
        return interfaces
    
    @staticmethod
    def active_connections() -> List[Connection]:
        """Analyze active network connections with process info."""
        TerminalUI.h1("ACTIVE NETWORK CONNECTIONS")
        
        connections = []
        
        if not HAS_PSUTIL:
            TerminalUI.warn("psutil not installed")
            return connections
        
        try:
            conns = psutil.net_connections(kind="inet")
            established = [c for c in conns if c.status == "ESTABLISHED"]
            listen = [c for c in conns if c.status == "LISTEN"]
            
            TerminalUI.kv("Total inet connections", str(len(conns)), status="ok")
            TerminalUI.kv("ESTABLISHED", str(len(established)))
            TerminalUI.kv("LISTENING", str(len(listen)))
            
            # Display listening ports (potential entry points)
            if listen:
                TerminalUI.h2("LISTENING PORTS (ENTRY POINTS)")
                TerminalUI.table_row("PROTOCOL", "LOCAL ADDRESS", "LOCAL PORT", "PID")
                for c in listen[:20]:
                    proto = "TCP" if c.type == socket.SOCK_STREAM else "UDP"
                    local_ip = c.laddr.ip if hasattr(c.laddr, 'ip') else c.laddr[0]
                    local_port = c.laddr.port if hasattr(c.laddr, 'port') else c.laddr[1]
                    pid_str = str(c.pid) if c.pid else "-"
                    
                    try:
                        proc_name = psutil.Process(c.pid).name() if c.pid else "-"
                    except:
                        proc_name = "-"
                    
                    TerminalUI.table_row(proto, local_ip, str(local_port), f"{pid_str} ({proc_name})")
                    connections.append(Connection(
                        protocol=proto,
                        local_addr=local_ip,
                        local_port=local_port,
                        remote_addr="0.0.0.0",
                        remote_port=0,
                        status="LISTEN",
                        pid=c.pid,
                        process_name=proc_name
                    ))
            
            # Display established connections
            if established:
                TerminalUI.h2(f"ESTABLISHED CONNECTIONS (showing {min(15, len(established))} of {len(established)})")
                TerminalUI.table_row("PROTOCOL", "LOCAL", "REMOTE", "PROCESS")
                for c in established[:15]:
                    proto = "TCP" if c.type == socket.SOCK_STREAM else "UDP"
                    local_ip = c.laddr.ip if hasattr(c.laddr, 'ip') else c.laddr[0]
                    local_port = c.laddr.port if hasattr(c.laddr, 'port') else c.laddr[1]
                    remote_ip = c.raddr.ip if hasattr(c.raddr, 'ip') else c.raddr[0]
                    remote_port = c.raddr.port if hasattr(c.raddr, 'port') else c.raddr[1]
                    
                    try:
                        proc_name = psutil.Process(c.pid).name() if c.pid else "-"
                    except:
                        proc_name = "-"
                    
                    laddr_str = f"{local_ip}:{local_port}"
                    raddr_str = f"{remote_ip}:{remote_port}"
                    TerminalUI.table_row(proto, laddr_str, raddr_str, proc_name)
                    
                    connections.append(Connection(
                        protocol=proto,
                        local_addr=local_ip,
                        local_port=local_port,
                        remote_addr=remote_ip,
                        remote_port=remote_port,
                        status="ESTABLISHED",
                        pid=c.pid,
                        process_name=proc_name
                    ))
        
        except psutil.AccessDenied:
            TerminalUI.warn("Access Denied: Run as root/Administrator for full connection visibility")
        except Exception as e:
            TerminalUI.warn(f"Error analyzing connections: {e}")
        
        return connections
    
    @staticmethod
    def dns_info() -> List[str]:
        """Extract DNS configuration."""
        TerminalUI.h1("DNS CONFIGURATION")
        
        dns_servers = []
        
        try:
            if NetworkDiagnostics.OS_TYPE == "Darwin":
                out = CommandExecutor.run(["scutil", "--dns"])
                dns_ips = re.findall(r"nameserver\[[\d]+\]\s*:\s*([\d.]+)", out)
                dns_servers.extend(dns_ips)
                
            elif NetworkDiagnostics.OS_TYPE == "Linux":
                for f_path in ("/etc/resolv.conf", "/run/systemd/resolve/resolv.conf"):
                    if os.path.exists(f_path):
                        try:
                            with open(f_path, 'r') as fh:
                                for line in fh:
                                    if line.startswith("nameserver"):
                                        ip = line.split()[-1]
                                        if ip not in dns_servers:
                                            dns_servers.append(ip)
                                            TerminalUI.dim(f"Found: {ip}")
                                break
                        except OSError as e:
                            TerminalUI.warn(f"Cannot read {f_path}: {e}")
                
            elif NetworkDiagnostics.OS_TYPE == "Windows":
                out = CommandExecutor.run([
                    "powershell", "-NoProfile", "-Command",
                    "Get-DnsClientServerAddress -AddressFamily IPv4 | Select-Object -ExpandProperty ServerAddresses"
                ])
                dns_servers.extend(out.strip().split('\n'))
        
        except Exception as e:
            TerminalUI.warn(f"Error retrieving DNS: {e}")
        
        dns_servers = [d.strip() for d in dns_servers if d.strip()]
        for dns in dns_servers:
            TerminalUI.kv("DNS Server", dns)
        
        return dns_servers
    
    @staticmethod
    def wifi_details() -> None:
        """Gather WiFi connection details."""
        TerminalUI.h1("WIFI CONNECTIVITY STATUS")
        
        if NetworkDiagnostics.OS_TYPE == "Darwin":
            airport_path = "/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport"
            if os.path.exists(airport_path):
                out = CommandExecutor.run([airport_path, "-I"])
                if out:
                    TerminalUI.h2("Current WiFi Association")
                    for line in out.splitlines():
                        if ":" in line:
                            k, _, v = line.partition(":")
                            TerminalUI.kv(k.strip(), v.strip())
        
        elif NetworkDiagnostics.OS_TYPE == "Linux":
            out = CommandExecutor.run(["nmcli", "connection", "show", "--active"])
            if out:
                TerminalUI.h2("Active WiFi Network")
                TerminalUI.dim(out)
        
        elif NetworkDiagnostics.OS_TYPE == "Windows":
            CommandExecutor.run_and_print(
                ["netsh", "wlan", "show", "interfaces"],
                "WLAN Interface Status"
            )


# ─────────────────────────────────────────────────────────────────────────────
# REPORT GENERATION - HTML & JSON
# ─────────────────────────────────────────────────────────────────────────────
class ReportGenerator:
    """Generate professional diagnostic reports."""
    
    @staticmethod
    def generate_html_report(scan_result: ScanResult, output_path: str = None) -> str:
        """Generate interactive HTML report."""
        
        if output_path is None:
            reports_dir = Path.home() / ".wifi_diagnostic" / "reports"
            reports_dir.mkdir(parents=True, exist_ok=True)
            output_path = reports_dir / f"network_report_{scan_result.scan_id}.html"
        
        # Security score color coding
        if scan_result.security_score >= 80:
            score_color = "#3fb950"  # Green
            score_status = "SECURE"
        elif scan_result.security_score >= 60:
            score_color = "#d29922"  # Orange
            score_status = "WARNING"
        else:
            score_color = "#f85149"  # Red
            score_status = "CRITICAL"
        
        # Build alerts HTML
        alerts_html = ""
        for alert in scan_result.alerts:
            if alert.level == SecurityLevel.CRITICAL:
                alert_color = "#f85149"
                icon = "🚨"
            elif alert.level == SecurityLevel.HIGH:
                alert_color = "#d29922"
                icon = "⚠️"
            else:
                alert_color = "#3fb950"
                icon = "ℹ️"
            
            alerts_html += f"""
            <div style="background-color: {alert_color}22; border-left: 4px solid {alert_color}; padding: 12px; margin: 8px 0; border-radius: 4px;">
                <div style="color: {alert_color}; font-weight: bold;">{icon} {alert.level.value} - {alert.category}</div>
                <div style="color: #c9d1d9; margin-top: 6px;">{html.escape(alert.message)}</div>
                <div style="color: #8b949e; font-style: italic; margin-top: 4px;">Remediation: {html.escape(alert.remediation)}</div>
            </div>
            """
        
        # Build interfaces HTML
        interfaces_html = ""
        for iface in scan_result.interfaces:
            interfaces_html += f"""
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{html.escape(iface.name)}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{iface.status}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{html.escape(iface.ipv4 or '-')}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{html.escape(iface.mac or '-')}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{iface.speed or '-'} Mbps</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{iface.bytes_sent / (1024*1024):.1f} MB</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{iface.bytes_recv / (1024*1024):.1f} MB</td>
            </tr>
            """
        
        # Build connections HTML
        connections_html = ""
        for conn in scan_result.connections[:30]:
            connections_html += f"""
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{conn.protocol}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{html.escape(conn.local_addr)}:{conn.local_port}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{html.escape(conn.remote_addr)}:{conn.remote_port}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{conn.status}</td>
                <td style="padding: 8px; border-bottom: 1px solid #30363d;">{html.escape(conn.process_name or '-')}</td>
            </tr>
            """
        
        full_output = html.escape("".join(sys_logger.log_buffer))
        
        html_content = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Network Diagnostic Report</title>
            <style>
                * {{ margin: 0; padding: 0; box-sizing: border-box; }}
                body {{
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', monospace;
                    background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
                    color: #c9d1d9;
                    line-height: 1.6;
                }}
                .container {{ max-width: 1200px; margin: 0 auto; padding: 20px; }}
                .header {{
                    background: linear-gradient(135deg, #0366d6 0%, #1f6feb 100%);
                    padding: 30px;
                    border-radius: 8px;
                    margin-bottom: 30px;
                    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
                }}
                .header h1 {{ font-size: 2em; margin-bottom: 10px; }}
                .score-card {{
                    background: #161b22;
                    padding: 20px;
                    border-radius: 8px;
                    margin: 20px 0;
                    border-left: 4px solid {score_color};
                }}
                .score-display {{
                    font-size: 3em;
                    font-weight: bold;
                    color: {score_color};
                    text-align: center;
                }}
                .status-text {{
                    text-align: center;
                    font-size: 1.2em;
                    color: {score_color};
                    margin-top: 10px;
                }}
                .section {{
                    background: #161b22;
                    padding: 20px;
                    border-radius: 8px;
                    margin: 20px 0;
                    border-top: 3px solid #30363d;
                }}
                .section h2 {{
                    color: #58a6ff;
                    margin-bottom: 15px;
                    font-size: 1.5em;
                    border-bottom: 2px solid #30363d;
                    padding-bottom: 10px;
                }}
                table {{
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 10px;
                }}
                th {{
                    background: #0d1117;
                    color: #58a6ff;
                    padding: 12px;
                    text-align: left;
                    font-weight: bold;
                }}
                .alert-box {{ background: #0d1117; padding: 15px; border-radius: 8px; }}
                .meta {{ color: #8b949e; font-size: 0.9em; margin-bottom: 20px; }}
                .footer {{
                    text-align: center;
                    padding: 20px;
                    color: #8b949e;
                    border-top: 1px solid #30363d;
                    margin-top: 40px;
                }}
                pre {{
                    background: #0d1117;
                    padding: 15px;
                    border-radius: 8px;
                    overflow-x: auto;
                    font-size: 12px;
                    max-height: 400px;
                    overflow-y: auto;
                }}
            </style>
        </head>
        <body>
            <div class="container">
                <div class="header">
                    <h1>🔍 Network Diagnostic Report</h1>
                    <p>Enterprise-Grade WiFi & Network Analysis</p>
                </div>
                
                <div class="meta">
                    <strong>Scan ID:</strong> {scan_result.scan_id}<br>
                    <strong>Timestamp:</strong> {scan_result.timestamp:%Y-%m-%d %H:%M:%S}<br>
                    <strong>Hostname:</strong> {html.escape(scan_result.hostname)}<br>
                    <strong>OS:</strong> {html.escape(scan_result.os_type)}
                </div>
                
                <div class="score-card">
                    <div class="score-display">{scan_result.security_score:.1f}/100</div>
                    <div class="status-text">{score_status}</div>
                </div>
                
                <div class="section">
                    <h2>🚨 Security Alerts ({len(scan_result.alerts)})</h2>
                    <div class="alert-box">
                        {alerts_html if alerts_html else '<p style="color: #3fb950;">✓ No security issues detected</p>'}
                    </div>
                </div>
                
                <div class="section">
                    <h2>🌐 Network Interfaces</h2>
                    <table>
                        <tr>
                            <th>Interface</th>
                            <th>Status</th>
                            <th>IPv4</th>
                            <th>MAC Address</th>
                            <th>Speed</th>
                            <th>Sent</th>
                            <th>Received</th>
                        </tr>
                        {interfaces_html}
                    </table>
                </div>
                
                <div class="section">
                    <h2>🔗 Active Connections (showing {min(30, len(scan_result.connections))} of {len(scan_result.connections)})</h2>
                    <table>
                        <tr>
                            <th>Protocol</th>
                            <th>Local Address</th>
                            <th>Remote Address</th>
                            <th>Status</th>
                            <th>Process</th>
                        </tr>
                        {connections_html}
                    </table>
                </div>
                
                <div class="section">
                    <h2>📋 Full Scan Output</h2>
                    <pre>{full_output}</pre>
                </div>
                
                <div class="footer">
                    <p>Generated by Network Diagnostic Pro v3.0 | Hacker Edition</p>
                    <p>Report path: {output_path}</p>
                </div>
            </div>
        </body>
        </html>
        """
        
        with open(output_path, "w", encoding="utf-8") as f:
            f.write(html_content)
        
        return str(output_path)
    
    @staticmethod
    def generate_json_report(scan_result: ScanResult, output_path: str = None) -> str:
        """Generate JSON report for API integration."""
        
        if output_path is None:
            reports_dir = Path.home() / ".wifi_diagnostic" / "reports"
            reports_dir.mkdir(parents=True, exist_ok=True)
            output_path = reports_dir / f"network_report_{scan_result.scan_id}.json"
        
        report_data = {
            'scan_id': scan_result.scan_id,
            'timestamp': scan_result.timestamp.isoformat(),
            'hostname': scan_result.hostname,
            'os_type': scan_result.os_type,
            'security_score': scan_result.security_score,
            'interfaces': [asdict(i) for i in scan_result.interfaces],
            'connections': [asdict(c) for c in scan_result.connections],
            'dns_servers': scan_result.dns_servers,
            'gateways': scan_result.gateways,
            'alerts': [
                {
                    'level': a.level.value,
                    'category': a.category,
                    'message': a.message,
                    'timestamp': a.timestamp.isoformat(),
                    'remediation': a.remediation
                } for a in scan_result.alerts
            ]
        }
        
        with open(output_path, "w", encoding="utf-8") as f:
            json.dump(report_data, f, indent=2, default=str)
        
        return str(output_path)


# ─────────────────────────────────────────────────────────────────────────────
# MAIN ORCHESTRATOR
# ─────────────────────────────────────────────────────────────────────────────
def main() -> None:
    """Main diagnostic engine orchestrator."""
    
    # Banner
    print(f"\n{TerminalUI.BOLD}{TerminalUI.BLUE}{'═' * 80}{TerminalUI.RESET}")
    print(f"{TerminalUI.BOLD}{TerminalUI.CYAN}")
    print(f"  ██╗    ██╗██╗███████╗██╗    ██╗██╗    ██╗")
    print(f"  ██║    ██║██║██╔════╝██║    ██║██║    ██║")
    print(f"  ██║ █╗ ██║██║█████╗  ██║    ██║██║    ██║")
    print(f"  ╚██████╔╝██║╚═════╝  ██║    ██║╚═════╚═╝")
    print(f"{TerminalUI.RESET}{TerminalUI.BOLD}{TerminalUI.BLUE}{'═' * 80}{TerminalUI.RESET}\n")
    
    print(f"{TerminalUI.BOLD}{TerminalUI.GREEN}Network & WiFi Diagnostic Tool - Hacker Pro Edition v3.0{TerminalUI.RESET}")
    print(f"{TerminalUI.DIM}Advanced Security Analysis | Threat Detection | Historical Tracking{TerminalUI.RESET}\n")
    
    # Generate scan ID
    scan_id = hashlib.md5(f"{datetime.now().isoformat()}".encode()).hexdigest()[:12]
    
    # Check dependencies
    if not HAS_PSUTIL:
        print(f"{TerminalUI.YELLOW}⚠  TIP: Install psutil for full network analysis →  pip install psutil{TerminalUI.RESET}\n")
    
    # Initialize database
    db = DiagnosticDatabase()
    
    # ─────────────────────────────────────────────────────────────────────────
    # PHASE 1: SYNCHRONOUS DIAGNOSTIC GATHERING
    # ─────────────────────────────────────────────────────────────────────────
    print(f"{TerminalUI.BOLD}{TerminalUI.CYAN}[PHASE 1] Gathering System Information...{TerminalUI.RESET}\n")
    
    system_info = NetworkDiagnostics.system_info()
    interfaces = NetworkDiagnostics.network_interfaces()
    connections = NetworkDiagnostics.active_connections()
    
    # ─────────────────────────────────────────────────────────────────────────
    # PHASE 2: CONCURRENT I/O-BOUND OPERATIONS
    # ─────────────────────────────────────────────────────────────────────────
    print(f"\n{TerminalUI.BOLD}{TerminalUI.CYAN}[PHASE 2] Running Concurrent Diagnostics...{TerminalUI.RESET}\n")
    
    concurrent_tasks = [
        ('WiFi Details', lambda: NetworkDiagnostics.wifi_details()),
        ('DNS Configuration', lambda: NetworkDiagnostics.dns_info()),
    ]
    
    dns_servers = []
    with ThreadPoolExecutor(max_workers=4) as executor:
        futures = {executor.submit(task_func): task_name for task_name, task_func in concurrent_tasks}
        
        for future in as_completed(futures, timeout=30):
            task_name = futures[future]
            try:
                result = future.result(timeout=10)
                if task_name == 'DNS Configuration':
                    dns_servers = result or []
            except FuturesTimeoutError:
                TerminalUI.warn(f"Task '{task_name}' timed out")
            except Exception as e:
                TerminalUI.warn(f"Task '{task_name}' failed: {e}")
    
    # ─────────────────────────────────────────────────────────────────────────
    # PHASE 3: SECURITY ANALYSIS
    # ─────────────────────────────────────────────────────────────────────────
    print(f"\n{TerminalUI.BOLD}{TerminalUI.CYAN}[PHASE 3] Performing Security Analysis...{TerminalUI.RESET}\n")
    
    SecurityAnalyzer.alerts = []
    SecurityAnalyzer.analyze_interfaces(interfaces)
    SecurityAnalyzer.analyze_connections(connections)
    
    security_score = SecurityAnalyzer.calculate_security_score(SecurityAnalyzer.alerts)
    
    TerminalUI.h1("SECURITY ANALYSIS RESULTS")
    TerminalUI.kv("Security Score", f"{security_score:.1f}/100", 
                  status="ok" if security_score >= 80 else "warn" if security_score >= 60 else "critical")
    TerminalUI.kv("Alerts Found", str(len(SecurityAnalyzer.alerts)))
    
    if SecurityAnalyzer.alerts:
        TerminalUI.h2("Detected Issues:")
        for i, alert in enumerate(SecurityAnalyzer.alerts, 1):
            level_icon = {"CRITICAL": "🚨", "HIGH": "⚠️", "MEDIUM": "⚡", "LOW": "ℹ️"}
            icon = level_icon.get(alert.level.value, "•")
            print(f"  {icon} [{alert.level.value}] {alert.category}: {alert.message}")
    else:
        TerminalUI.success("No security issues detected!")
    
    # ─────────────────────────────────────────────────────────────────────────
    # PHASE 4: BUILD SCAN RESULT
    # ─────────────────────────────────────────────────────────────────────────
    scan_result = ScanResult(
        scan_id=scan_id,
        timestamp=datetime.now(),
        hostname=system_info['hostname'],
        os_type=system_info['os'],
        interfaces=interfaces,
        connections=connections,
        dns_servers=dns_servers,
        gateways=[],
        alerts=SecurityAnalyzer.alerts,
        security_score=security_score
    )
    
    # ─────────────────────────────────────────────────────────────────────────
    # PHASE 5: SAVE TO DATABASE
    # ─────────────────────────────────────────────────────────────────────────
    print(f"\n{TerminalUI.BOLD}{TerminalUI.CYAN}[PHASE 5] Archiving Results...{TerminalUI.RESET}\n")
    db.save_scan(scan_result)
    TerminalUI.success(f"Scan results saved to database (ID: {scan_id})")
    
    # Show trends
    trends = db.get_trend_analysis(days=7)
    if trends:
        TerminalUI.h2("7-Day Trend Analysis")
        TerminalUI.kv("Average Security Score", f"{trends['avg_score']:.1f}")
        TerminalUI.kv("Scans Performed", str(trends['scan_count']))
    
    # ─────────────────────────────────────────────────────────────────────────
    # PHASE 6: REPORT GENERATION
    # ─────────────────────────────────────────────────────────────────────────
    print(f"\n{TerminalUI.BOLD}{TerminalUI.CYAN}[PHASE 6] Generating Reports...{TerminalUI.RESET}\n")
    
    html_report = ReportGenerator.generate_html_report(scan_result)
    json_report = ReportGenerator.generate_json_report(scan_result)
    
    TerminalUI.success(f"HTML Report: {html_report}")
    TerminalUI.success(f"JSON Report: {json_report}")
    
    # ─────────────────────────────────────────────────────────────────────────
    # COMPLETION
    # ─────────────────────────────────────────────────────────────────────────
    print(f"\n{TerminalUI.BOLD}{TerminalUI.CYAN}{'═' * 80}{TerminalUI.RESET}")
    print(f"{TerminalUI.BOLD}{TerminalUI.GREEN}✔  Comprehensive Network Diagnostic Scan Complete{TerminalUI.RESET}\n")
    
    # Open report
    try:
        webbrowser.open(f"file://{html_report}")
    except:
        pass


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{TerminalUI.RED}  Scan interrupted by user.{TerminalUI.RESET}\n")
        sys.exit(130)
    except Exception as e:
        print(f"\n{TerminalUI.RED}  CRITICAL ERROR: {e}{TerminalUI.RESET}\n")
        import traceback
        traceback.print_exc()
        sys.exit(1)